@{
    ViewData["Title"] = "طباعة عقد";
}

<div class="container mt-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Search by contract number -->
                    <div class="mb-4">
                        <h5 class="text-center mb-3">بحث برقم العقد</h5>
                        <div class="input-group">
                            <input type="text" id="quickContractNo" class="form-control" placeholder="أدخل رقم العقد">
                            <button class="btn btn-success" onclick="searchByContractNo()">
                                <i class="fas fa-search"></i> طباعة
                            </button>
                        </div>
                    </div>

                    <hr>

                    <!-- Search by employee code -->
                    <div class="mb-4">
                        <h5 class="text-center mb-3">بحث بكود الموظف</h5>
                        <div class="input-group">
                            <input type="text" id="quickEmpCode" class="form-control" placeholder="أدخل كود الموظف">
                            <button class="btn btn-success" onclick="searchByEmpCode()">
                                <i class="fas fa-search"></i> بحث
                            </button>
                        </div>
                    </div>

                    <hr>

                    <!-- Search by employee name (autocomplete) -->
                    <div class="mt-4">
                        <h5 class="text-center mb-3">أو ابحث باسم الموظف</h5>
                        <select id="employeeSelect" class="form-control">
                            <option value="">اكتب اسم الموظف، الرقم المدني، أو الكود</option>
                        </select>
                        <div class="text-center mt-3">
                            <button id="selectEmployeeBtn" class="btn btn-warning" disabled>
                                <i class="fas fa-file-word"></i> عرض عقود الموظف
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('#employeeSelect').select2({
            ajax: {
                url: '@Url.Action("GetEmployeeSuggestions", "ContractGeneration")',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { term: params.term };
                },
                processResults: function (data) {
                    return { results: data };
                }
            },
            minimumInputLength: 2,
            placeholder: 'ابحث عن موظف...',
            language: {
                noResults: function () {
                    return "لم يتم العثور على نتائج";
                }
            }
        });

        $('#employeeSelect').on('select2:select', function (e) {
            var data = e.params.data;
            $('#selectEmployeeBtn').prop('disabled', false).data('employeeId', data.id);
        });

        $('#selectEmployeeBtn').click(function () {
            var employeeId = $(this).data('employeeId');
            if (employeeId) {
                window.location.href = '@Url.Action("EmployeeContracts", "ContractGeneration")?employeeId=' + employeeId;
            }
        });
    });

    function searchByContractNo() {
        var contractNo = $('#quickContractNo').val();
        if (contractNo) {
            window.location.href = '/ContractGeneration/QuickByContractNo?contractNo=' + encodeURIComponent(contractNo);
        } else {
            alert('الرجاء إدخال رقم العقد');
        }
    }

    function searchByEmpCode() {
        var empCode = $('#quickEmpCode').val();
        if (empCode) {
            window.location.href = '/ContractGeneration/QuickByEmployeeCode?empCode=' + encodeURIComponent(empCode);
        } else {
            alert('الرجاء إدخال كود الموظف');
        }
    }

    $('#quickContractNo, #quickEmpCode').keypress(function (e) {
        if (e.which == 13) {
            if ($(this).attr('id') === 'quickContractNo') {
                searchByContractNo();
            } else {
                searchByEmpCode();
            }
            return false;
        }
    });
</script>